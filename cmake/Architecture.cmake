# This is always based on the %PROCESSOR_ARCHITECTURE% environment variable.
if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "AMD64")
    set(REPEAT_HOST_ARCH "x64")
elseif(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "x86")
    set(REPEAT_HOST_ARCH "x86")
elseif(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "ARM64")
    set(REPEAT_HOST_ARCH "ARM64")
elseif(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "ARM")
    set(REPEAT_HOST_ARCH "ARM")
else()
    # Safe fallback.
    set(REPEAT_HOST_ARCH "x86")
endif()

if(CMAKE_SYSTEM_PROCESSOR MATCHES "AMD64|x86_64")
    set(REPEAT_ARCH "x86_64")
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "x86|i686")
    set(REPEAT_ARCH "i686")
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "ARM64|aarch64")
    set(REPEAT_ARCH "aarch64")
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "ARM|armv7")
    set(REPEAT_ARCH "armv7")
else()
    # Safe fallback.
    set(REPEAT_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
endif()
